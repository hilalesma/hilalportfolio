    "vendor": "node scripts/build-vendor.mjs",
    "partials": "node scripts/sync-partials.mjs",
    "validate": "html-validate \"*.html\" \"blog/*.html\"",
    "links": "node scripts/check-links.mjs",
    "shots": "node scripts/shots.mjs docs/shots",
    "intro-check": "node scripts/intro-check.mjs",
    "valley-still": "node scripts/valley-still.mjs",
    "cursor-check": "node scripts/cursor-check.mjs",
    "sparks-check": "node scripts/sparks-check.mjs",
    "ribbons-check": "node scripts/ribbons-check.mjs",
    "projeler-check": "node scripts/projeler-check.mjs",
    "prepare-projects": "node scripts/prepare-projects.mjs",
    "scroll-check": "node scripts/scroll-check.mjs",
    "qa": "node scripts/qa.mjs",
    "checklist": "node scripts/checklist.mjs",
    "assets": "node scripts/prepare-assets.mjs",
    "magnetic-check": "node scripts/magnetic-check.mjs",
    "effects-check": "node scripts/effects-check.mjs",
    "sky-check": "node scripts/sky-check.mjs",
    "blog-check": "node scripts/blog-check.mjs",
    "studio-check": "node scripts/studio-check.mjs",
    "player-check": "node scripts/player-check.mjs",
    "valley-return-check": "node scripts/valley-return-check.mjs",
    "seo": "node scripts/build-seo.mjs",
    "a11y-check": "node scripts/a11y-check.mjs",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1",
    "report-shots": "node scripts/report-shots.mjs",
    "contact-check": "node scripts/contact-check.mjs"
  },
  "devDependencies": {
    "@fontsource/antonio": "^5.2.6",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/pinyon-script": "^5.3.0",
    "esbuild": "^0.28.2",
    "gsap": "^3.15.1",
    "html-validate": "^11.21.1",
    "lenis": "^1.3.11",
    "lighthouse": "^13.6.0",
    "playwright-core": "^1.65.1",
    "sharp": "^0.35.5",
    "three": "^0.187.0"
  }
}
